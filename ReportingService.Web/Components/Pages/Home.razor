@page "/"

<PageTitle>Home</PageTitle>

<div class="space-y-8">
    <div>
        <h1 class="text-3xl font-bold text-gray-900">Welcome to Reporting Service</h1>
        <p class="mt-2 text-gray-600">Manage your automated report schedules with ease.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <a href="schedules" class="group bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-lg hover:border-primary-500 transition-all duration-200">
            <div class="flex items-center gap-4">
                <div class="p-3 bg-primary-100 rounded-lg group-hover:bg-primary-200 transition-colors">
                    <svg class="w-8 h-8 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                </div>
                <div>
                    <h3 class="text-lg font-semibold text-gray-900">Schedules</h3>
                    <p class="text-sm text-gray-500">Create and manage report schedules</p>
                </div>
            </div>
            <div class="mt-4 flex items-center text-primary-600 font-medium">
                <span>Manage Schedules</span>
                <svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
            </div>
        </a>

        <a href="reports" class="group bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-lg hover:border-primary-500 transition-all duration-200">
            <div class="flex items-center gap-4">
                <div class="p-3 bg-green-100 rounded-lg group-hover:bg-green-200 transition-colors">
                    <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                </div>
                <div>
                    <h3 class="text-lg font-semibold text-gray-900">Reports</h3>
                    <p class="text-sm text-gray-500">View generated reports</p>
                </div>
            </div>
            <div class="mt-4 flex items-center text-green-600 font-medium">
                <span>View Reports</span>
                <svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
            </div>
        </a>

        <div class="bg-gradient-to-br from-primary-500 to-primary-700 rounded-xl shadow-sm p-6 text-white">
            <div class="flex items-center gap-4">
                <div class="p-3 bg-white/20 rounded-lg">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                    </svg>
                </div>
                <div>
                    <h3 class="text-lg font-semibold">Quick Start</h3>
                    <p class="text-sm text-primary-100">Get started in minutes</p>
                </div>
            </div>
            <p class="mt-4 text-sm text-primary-100">
                Create your first schedule to automate report generation and delivery.
            </p>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
        <h2 class="text-xl font-semibold text-gray-900 mb-4">How It Works</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="flex items-start gap-4">
                <div class="flex-shrink-0 w-8 h-8 bg-primary-100 rounded-full flex items-center justify-center text-primary-600 font-bold">1</div>
                <div>
                    <h4 class="font-medium text-gray-900">Create Schedule</h4>
                    <p class="text-sm text-gray-500 mt-1">Define when and how often your reports should be generated.</p>
                </div>
            </div>
            <div class="flex items-start gap-4">
                <div class="flex-shrink-0 w-8 h-8 bg-primary-100 rounded-full flex items-center justify-center text-primary-600 font-bold">2</div>
                <div>
                    <h4 class="font-medium text-gray-900">Configure Options</h4>
                    <p class="text-sm text-gray-500 mt-1">Set recurrence patterns, data retention, and delivery preferences.</p>
                </div>
            </div>
            <div class="flex items-start gap-4">
                <div class="flex-shrink-0 w-8 h-8 bg-primary-100 rounded-full flex items-center justify-center text-primary-600 font-bold">3</div>
                <div>
                    <h4 class="font-medium text-gray-900">Automatic Delivery</h4>
                    <p class="text-sm text-gray-500 mt-1">Reports are generated and delivered automatically on schedule.</p>
                </div>
            </div>
        </div>
    </div>
</div>
